DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require&channel_binding=require
DIRECT_DATABASE_URL=postgresql://.../neondb?sslmode=require&channel_binding=require

SECRET_KEY=python3 -c "import secrets; print(secrets.token_hex(32))"
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=
GROQ_API_KEY=
# Groq retires models periodically; if replies come back as the bilingual
# "brief issue" fallback, list reachable models and update this.
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

REDIS_URL=rediss://your-upstash-redis-url-here
REDIS_TOKEN=

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=


KNOWLEDGE_BASE_MAX_UPLOAD_MB=25

# Optional. Absolute path to AISHA's persona/system prompt. Leave unset unless
# the prompt lives outside the checkout (mounted ConfigMap, secrets volume…);
# the default resolves to backend/knowledge_base/system_prompts/aisha_voice.txt
# both on a host checkout and inside the container. If this file is missing OR
# empty, the knowledge-base manager logs an error and falls back to a generic
# prompt that carries none of the [LANG:xx]/[HANDOVER_REQUIRED]/[SHOW_CATEGORIES]
# tag contracts, which silently disables language tagging, human handover and
# category browsing.
AISHA_SYSTEM_PROMPT_PATH=


BASE_URL=ngrok url
LOG_LEVEL=

TWILIO_QUICK_REPLY_SID=  your SID after you run create_templates.py
TWILIO_LIST_PICKER_SID=  your SID after you run create_templates.py
TWILIO_BROWSE_MORE_SID=  your SID after you run create_templates.py
